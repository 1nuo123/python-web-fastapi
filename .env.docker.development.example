APP_ENV=development
APP_HOST_PORT=8001
POSTGRES_HOST_PORT=55433
POSTGRES_DB=fastapi_web_codex_development
POSTGRES_USER=fastapi_codex_development
POSTGRES_PASSWORD=replace_with_development_postgres_password
DATABASE_URL=postgresql+psycopg://fastapi_codex_development:replace_with_development_postgres_password@127.0.0.1:55433/fastapi_web_codex_development
REDIS_HOST_PORT=56380
REDIS_PASSWORD=replace_with_development_redis_password
JWT_SECRET=replace_with_development_jwt_secret_minimum_32_characters
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_development_bootstrap_password
RABBITMQ_DEFAULT_USER=fastapi_codex_development
RABBITMQ_DEFAULT_PASS=replace_with_development_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_HOST_PORT=55672
RABBITMQ_MANAGEMENT_HOST_PORT=15673
EDGE_NETWORK_NAME=fastapi-web-development-edge
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_DEV_SITE_ADDRESS=codex-dev.lan
