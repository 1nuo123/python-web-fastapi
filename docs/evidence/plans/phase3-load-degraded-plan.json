{
  "output_directory": "docs/evidence/load/current-final",
  "stop_on_failure": false,
  "steps": [
    {
      "name": "dependency-stop",
      "argv": ["docker", "compose", "stop", "redis"],
      "timeout_seconds": 60
    },
    {
      "name": "dependency-degraded",
      "argv": [".venv/Scripts/locust.exe", "-f", "test/performance/scenarios/locustfile.py", "--headless", "--only-summary", "-u", "8", "-r", "4", "-t", "10s", "--host", "http://127.0.0.1:8000", "--csv", "docs/evidence/load/current-final/dependency-degraded", "--html", "docs/evidence/load/current-final/dependency-degraded.html"],
      "timeout_seconds": 60,
      "environment": [
        {"name": "PYTHONUTF8", "value": "1"},
        {"name": "LOAD_SCENARIO_KIND", "value": "dependency_degraded"},
        {"name": "LOAD_SCENARIO_NAME", "value": "dependency-degraded"},
        {"name": "LOAD_USERS", "value": "8"},
        {"name": "LOAD_DURATION_SECONDS", "value": "10"},
        {"name": "LOAD_INJECTED_LATENCY_MILLISECONDS", "value": "500"},
        {"name": "LOAD_EXPECTED_STATUS_CODES", "value": "503"}
      ]
    },
    {
      "name": "dependency-start",
      "argv": ["docker", "compose", "up", "-d", "--wait", "redis", "app"],
      "timeout_seconds": 180
    }
  ]
}
