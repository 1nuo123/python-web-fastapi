{
	admin 127.0.0.1:2019
}

{$CADDY_DEV_SITE_ADDRESS:codex-dev.lan} {
	tls internal
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	log {
		output stdout
		format json
	}

	route {
		@codex_realtime_ticket path /api/codex/realtime-tickets
		handle @codex_realtime_ticket {
			rewrite * /codex/realtime-tickets
			reverse_proxy app:8000 {
				# Keep ticket issuance on the same gateway as the WebSocket.
				header_up -Forwarded
				health_uri /health/ready
				health_interval 30s
				health_timeout 5s
			}
		}

		@codex_events path /codex/events
		reverse_proxy @codex_events app:8000 {
			# Caddy is the public boundary; never propagate a client-supplied Forwarded header.
			header_up -Forwarded
			flush_interval -1
			health_uri /health/ready
			health_interval 30s
			health_timeout 5s
		}

		@backend path /auth/* /health/* /internal/* /codex/realtime-tickets /codex/hosts* /codex/approvals* /openapi.json
		reverse_proxy @backend app:8000 {
			# Caddy is the public boundary; never propagate a client-supplied Forwarded header.
			header_up -Forwarded
			health_uri /health/ready
			health_interval 30s
			health_timeout 5s
		}

		reverse_proxy frontend:3000 {
			# Caddy is the public boundary; never propagate a client-supplied Forwarded header.
			header_up -Forwarded
			health_uri /
			health_interval 30s
			health_timeout 5s
		}
	}
}
