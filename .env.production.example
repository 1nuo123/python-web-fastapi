APP_ENV=production
APP_HOST_PORT=8000
# 生产环境必须显式使用 --env-file、进程环境、Compose Secret 或外部 Secret Manager 注入变量；仓库根目录 .env 仅用于本地开发。
POSTGRES_HOST_PORT=55432
POSTGRES_DB=fastapi_web_skeleton
POSTGRES_USER=replace_with_production_postgres_user
POSTGRES_PASSWORD=replace_with_production_postgres_password
REDIS_HOST_PORT=56379
REDIS_PASSWORD=replace_with_production_redis_password
JWT_SECRET=replace_with_production_jwt_secret_minimum_32_characters
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_bootstrap_admin_password_or_remove_after_bootstrap
RABBITMQ_DEFAULT_USER=replace_with_production_rabbitmq_user
RABBITMQ_DEFAULT_PASS=replace_with_production_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_VHOST_ENCODED=%2F
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
