APP_ENV=production

# Runtime secrets. Generate unique values on the server; never commit the real file.
POSTGRES_DB=fastapi_web_skeleton
POSTGRES_USER=fastapi_prod
POSTGRES_PASSWORD=replace_with_random_postgres_password
REDIS_PASSWORD=replace_with_random_redis_password
JWT_SECRET=replace_with_random_jwt_secret_at_least_32_characters
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_random_unused_bootstrap_password
RABBITMQ_DEFAULT_USER=fastapi_prod
RABBITMQ_DEFAULT_PASS=replace_with_random_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_VHOST_ENCODED=%2F

# Public hostname used by Caddy for automatic HTTPS certificate management.
EDGE_NETWORK_NAME=fastapi-web-production-edge
CADDY_SITE_ADDRESS=nuotop.xyz
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Optional Cloudflare-only origin port. Leave empty unless an Origin Rule forwards nuotop.xyz to 8443.
CADDY_CLOUDFLARE_ORIGIN_HTTPS_PORT=
