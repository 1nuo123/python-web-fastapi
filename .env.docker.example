APP_ENV=development
APP_HOST_PORT=8000
POSTGRES_HOST_PORT=55432
POSTGRES_DB=fastapi_web_skeleton_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-postgres-password
DATABASE_URL=postgresql+psycopg://postgres:local-dev-postgres-password@127.0.0.1:55432/fastapi_web_skeleton_dev
REDIS_HOST_PORT=56379
JWT_SECRET=local-dev-jwt-secret-minimum-32-characters
AUTH_BOOTSTRAP_ADMIN_PASSWORD=local-dev-bootstrap-admin-password
RABBITMQ_DEFAULT_USER=fastapi_dev
RABBITMQ_DEFAULT_PASS=local-dev-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
